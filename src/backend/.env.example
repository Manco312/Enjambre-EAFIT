# Secreto para firmar/verificar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=changeme

# Vigencia del token de acceso (formato de `ms`/jsonwebtoken; por defecto 1d)
# JWT_EXPIRES_IN=1d

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000

# Orígenes permitidos por CORS, separados por comas (por defecto el dev de Vite)
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Credenciales que usa `npm run seed` para crear los usuarios iniciales
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

BOARD_USERNAME=junta.spie
BOARD_PASSWORD=junta123
